---
// TODO: reemplazar con los datos reales del equipo. Para agregar foto, importa la
// imagen desde src/assets y pásala en `photo`; si no hay foto se muestran las iniciales.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Member {
  name: string;
  role: string;
  bio: string;
  initials: string;
  color: string;
  photo?: ImageMetadata;
}

const team: Member[] = [
  {
    name: "Nombre de la directora",
    role: "Directora",
    bio: "Una frase sobre su experiencia y lo que la motiva a enseñar.",
    initials: "D",
    color: "bg-brand-pink",
  },
  {
    name: "Nombre de la maestra",
    role: "Maestra de preescolar",
    bio: "Una frase sobre su formación y su forma de trabajar con los niños.",
    initials: "M",
    color: "bg-brand-blue",
  },
  {
    name: "Nombre de la maestra",
    role: "Maestra de estancia infantil",
    bio: "Una frase sobre su formación y su forma de trabajar con los niños.",
    initials: "M",
    color: "bg-brand-green",
  },
];
---

<section id="team" class="bg-white pb-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <h2 class="font-display text-3xl font-extrabold leading-tight text-ink">
        Nuestro <span class="text-brand-pink">equipo</span>
      </h2>
      <p class="mx-auto mt-3 max-w-lg text-sm font-semibold text-ink/70 sm:text-base">
        Las personas que cuidan, enseñan y acompañan a tus hijos todos los días.
      </p>
    </div>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        team.map((member) => (
          <li class="flex flex-col items-center gap-3 rounded-3xl bg-cream p-6 text-center">
            {member.photo ? (
              <Image src={member.photo} alt={member.name} width={192} height={192} class="h-24 w-24 rounded-full border-4 border-white object-cover shadow-lg" />
            ) : (
              <span
                class:list={[
                  "flex h-24 w-24 items-center justify-center rounded-full border-4 border-white font-display text-3xl font-extrabold text-white shadow-lg",
                  member.color,
                ]}
                aria-hidden="true"
              >
                {member.initials}
              </span>
            )}
            <div>
              <h3 class="font-display text-lg font-extrabold text-ink">{member.name}</h3>
              <p class="text-sm font-bold text-brand-pink">{member.role}</p>
            </div>
            <p class="text-sm font-semibold leading-relaxed text-ink/75">{member.bio}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
