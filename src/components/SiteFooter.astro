---
import { Image } from "astro:assets";
import logo from "../assets/dss_logo.png";
import { business, fullAddress, whatsappLink } from "../data/site";

const socials = [
  { label: "Facebook", href: business.socials.facebook, icon: `<path d="M14 8h3V4h-3c-2.2 0-4 1.8-4 4v2H7v4h3v8h4v-8h3l1-4h-4V8c0-.6.4-1 1-1Z"/>` },
  { label: "Instagram", href: business.socials.instagram, icon: `<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1.2"/>` },
];
---

<footer id="footer" class="bg-leaf-dark text-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 text-center sm:px-6 md:grid-cols-3 md:text-left">
    <div class="flex flex-col items-center gap-4 md:items-start">
      <div class="bg-yellow-50/60 backdrop-blur-md border border-white/20 shadow-lg p-4 rounded-lg">
        <Image src={logo} alt="Divertido San Sebastián" class="h-12 w-auto" />
      </div>
      <p class="max-w-xs text-sm font-semibold text-white/75">
        Estancia infantil, preescolar, ludoteca y talleres en San Sebastián el Grande.
      </p>
    </div>

    <div class="flex flex-col items-center gap-3 md:items-start">
      <h3 class="font-display text-lg text-yellow-50 font-extrabold">Contacto</h3>
      <ul class="flex flex-col gap-2 text-sm font-semibold text-white/80">
        <li>{fullAddress}</li>
        <li>
          <a href={`tel:${business.phone}`} class="transition hover:text-white">{business.phoneLabel}</a>
        </li>
        <li>
          <a href={whatsappLink()} target="_blank" rel="noopener" class="transition hover:text-white">WhatsApp</a>
        </li>
        <li>Lunes a viernes, 8:30 a.m.–6 p.m.</li>
      </ul>
    </div>

    <div class="flex flex-col items-center gap-4 md:items-start">
      <h3 class="font-display text-lg text-yellow-50 font-extrabold">Síguenos en redes sociales</h3>
      <div class="flex gap-3">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              aria-label={s.label}
              class="flex h-10 w-10 items-center justify-center rounded-full bg-white/15 transition text-yellow-50 hover:bg-brand-yellow/30 hover:text-white duration-200"
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="border-t border-white/15 bg-[#5b3b1a]">
    <p class="mx-auto max-w-6xl px-4 py-5 text-center text-xs text-white/70 sm:px-6">
      <span class="block sm:inline">© 2026 Divertido San Sebastián.</span>
      <span class="block sm:inline">Todos los derechos reservados.</span>
      <a href="/aviso-de-privacidad" class="block underline transition hover:text-white sm:ml-2 sm:inline">Aviso de privacidad</a>
    </p>
  </div>
</footer>
