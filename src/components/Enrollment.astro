---
import { whatsappLink } from "../data/site";

const steps = [
  {
    title: "Agenda tu visita",
    text: "Escríbenos por WhatsApp o llámanos para elegir el día y la hora que mejor te acomode.",
    color: "bg-brand-blue",
    icon: `<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/><path d="m9 15 2 2 4-4"/>`,
  },
  {
    title: "Conoce las instalaciones",
    text: "Recorre los salones, platica con las maestras y resuelve todas tus dudas.",
    color: "bg-brand-green",
    icon: `<path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h14V10"/><path d="M10 20v-5h4v5"/>`,
  },
  {
    title: "Inscribe a tu hijo",
    text: "Te explicamos los requisitos y te acompañamos en todo el proceso.",
    color: "bg-brand-pink",
    icon: `<path d="M12 21s-7-4.4-9.2-9C1.3 9 3 5.5 6.4 5.5c2 0 3.6 1.3 4.6 3 1-1.7 2.6-3 4.6-3C19.6 5.5 21.3 9 20.2 12 18 16.6 12 21 12 21Z"/>`,
  },
];
---

<section id="enrollment" class="bg-white py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <h2 class="font-display text-3xl font-extrabold leading-tight text-ink">
        Inscribirte es <span class="text-brand-pink">muy fácil</span>
      </h2>
    </div>

    <ol class="mt-10 grid gap-6 md:grid-cols-3">
      {
        steps.map((step, i) => (
          <li class="relative flex flex-col items-center gap-3 rounded-3xl bg-blue-50 p-6 pt-10 text-center">
            <span
              class:list={[
                "absolute -top-5 flex h-10 w-10 items-center justify-center rounded-full font-display text-lg font-extrabold text-white shadow-lg",
                step.color,
              ]}
            >
              {i + 1}
            </span>
            <svg viewBox="0 0 24 24" class="h-8 w-8 text-ink/70" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={step.icon} />
            <h3 class="font-display text-lg font-extrabold text-ink">{step.title}</h3>
            <p class="text-sm font-semibold leading-relaxed text-ink/75">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 text-center">
      <a
        href={whatsappLink("¡Hola! Me gustaría agendar una visita para conocer Divertido San Sebastián.")}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full bg-brand-pink px-7 py-3.5 font-display text-sm font-extrabold uppercase tracking-wide text-white shadow-lg shadow-brand-pink/30 transition hover:-translate-y-0.5 hover:bg-brand-pink-dark"
      >
        Agenda tu visita
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
