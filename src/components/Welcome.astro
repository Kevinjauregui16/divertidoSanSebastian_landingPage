---
import { Image } from "astro:assets";
import welcomeImg from "../assets/dss_welcome.png";

const highlights = [
  {
    label: "+10 años formando pequeños grandes corazones",
    color: "bg-brand-pink/15 text-brand-pink",
    icon: `<path d="m12 3 2.5 5.5L20 9l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.5Z"/>`,
  },
  {
    label: "Espacios seguros, luminosos y llenos de amor",
    color: "bg-brand-green/15 text-brand-green",
    icon: `<path d="M12 3 5 6v5c0 5 3 8 7 10 4-2 7-5 7-10V6Z"/><path d="m9 12 2 2 4-4"/>`,
  },
  {
    label: "Familias que confían en nosotros cada día",
    color: "bg-brand-blue/15 text-brand-blue",
    icon: `<path d="M12 21s-7-4.4-9.2-9C1.3 9 3 5.5 6.4 5.5c2 0 3.6 1.3 4.6 3 1-1.7 2.6-3 4.6-3C19.6 5.5 21.3 9 20.2 12 18 16.6 12 21 12 21Z"/>`,
  },
];
---

<section id="about" class="relative overflow-hidden bg-white py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <!-- image -->
      <div class="relative mx-auto w-full max-w-md">
        <Image
          src={welcomeImg}
          widths={[448, 736]}
          sizes="(min-width: 448px) 448px, 100vw"
          alt="Grupo de niños sonriendo mientras juegan con bloques de colores"
          class="h-72 w-full rounded-[2.5rem] object-cover shadow-xl sm:h-full"
          loading="lazy"
        />
      </div>

      <!-- copy -->
      <div class="text-center lg:text-left">

        <h2 class="mt-4 font-display text-3xl font-extrabold leading-tight text-ink sm:text-4xl">
          ¡Bienvenidos a <span class="text-brand-pink">Divertido San Sebastián</span>!
        </h2>

        <p class="mx-auto mt-5 max-w-lg text-sm font-semibold leading-relaxed text-ink/75 sm:text-base lg:mx-0">
          Ofrecemos un entorno cálido y estimulante donde los niños desarrollan un
          amor por el aprendizaje para toda la vida. Nuestros programas se centran
          en la creatividad, la curiosidad y la confianza a través del juego.
        </p>
        <p class="mx-auto mt-3 max-w-lg text-sm font-semibold leading-relaxed text-ink/75 sm:text-base lg:mx-0">
          Contamos con maestras certificadas, instalaciones seguras y una comunidad
          de familias que crecen junto a nosotros, un pequeño paso a la vez.
        </p>

        <ul class="mx-auto mt-7 flex max-w-lg flex-col gap-3 lg:mx-0">
          {
            highlights.map((item) => (
              <li class="flex items-center gap-3 text-left text-sm font-bold text-ink/80">
                <span class:list={["flex h-9 w-9 shrink-0 items-center justify-center rounded-full", item.color]}>
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
                </span>
                {item.label}
              </li>
            ))
          }
        </ul>

        <a
          href="#features"
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-brand-pink px-7 py-3 font-display text-sm font-extrabold uppercase tracking-wide text-white shadow-lg shadow-brand-pink/30 transition hover:-translate-y-0.5 hover:bg-brand-pink-dark"
        >
          Conócenos más
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
